# ── Server ────────────────────────────────────────────────
# Node environment
NODE_ENV=development

# Port the API server listens on
PORT=5000

# Base URL of the API (used for docs + client CORS)
API_URL=http://localhost:5000/api

# PostgreSQL connection string (local docker-compose Postgres)
DATABASE_URL=postgresql://dictionary:dictionary@localhost:5432/dictionary

# JWT auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Free third-party API keys (leave blank to use public fallbacks)
DICTIONARY_API_URL=https://api.dictionaryapi.dev/api/v2/entries/en
DATAMUSE_API_URL=https://api.datamuse.com
LIBRETRANSLATE_API_URL=https://libretranslate.com/translate
LIBRETRANSLATE_API_KEY=

# ── Client ────────────────────────────────────────────────
# URL of the backend API used by the Vite client
VITE_API_URL=http://localhost:5000/api
